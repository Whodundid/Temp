Yep — that means the offsets are still wrong at the moment of remove, not that Swing suddenly developed morals.

The sneaky part is this: with JTextComponent, the root element can include a phantom trailing line or line offsets that do not behave the way your brain wants them to. So even if getText(...) worked, remove(...) can still blow up when one of these is true:

your endLine is actually the synthetic trailing empty line

your blockEnd is past doc.getLength()

your selection logic made startLine/endLine include or exclude the wrong line

you are relying too much on Element.getEndOffset() for document surgery, which is where Swing starts acting like a raccoon in a server room

The real fix
Stop using root-element offsets for the actual move operation.

Use Utilities.getRowStart(...) and Utilities.getRowEnd(...) instead. Those are way more reliable for line-based movement in a JTextComponent.

Here is a version that safely swaps the selected line/block with the one above or below:

import javax.swing.SwingUtilities;
import javax.swing.text.BadLocationException;
import javax.swing.text.Document;
import javax.swing.text.JTextComponent;
import javax.swing.text.Utilities;

protected static void moveLines(JTextComponent c, int direction, boolean applyScopeIndent) {
    if (c == null) return;

    final int dir = Math.max(-1, Math.min(1, direction));
    if (dir == 0) return;

    try {
        Document doc = c.getDocument();
        int docLen = doc.getLength();

        int selStart = c.getSelectionStart();
        int selEnd = c.getSelectionEnd();

        // If no selection, treat as current line
        if (selStart == selEnd) {
            selEnd = selStart;
        }

        // Determine selected block row bounds
        int blockStart = Utilities.getRowStart(c, selStart);
        int blockEndRow = Utilities.getRowEnd(c, Math.max(selStart, selEnd - 1));

        if (blockStart < 0 || blockEndRow < 0) return;

        // Include newline after block if one exists
        int blockEnd = blockEndRow;
        if (blockEnd < docLen) {
            blockEnd++;
        }

        if (dir < 0) {
            // Can't move up if already first row
            if (blockStart == 0) return;

            int prevLineEnd = blockStart - 1; // should be '\n' position of previous line
            int prevLineStart = Utilities.getRowStart(c, prevLineEnd);

            if (prevLineStart < 0) return;

            String prevText = doc.getText(prevLineStart, blockStart - prevLineStart);
            String blockText = doc.getText(blockStart, blockEnd - blockStart);

            if (applyScopeIndent) {
                String indentUnit = detectIndentUnit(doc);
                String desiredBaseIndent = computeDesiredIndentAt(doc, prevLineStart, indentUnit);
                blockText = reindentBlock(blockText, desiredBaseIndent, indentUnit);
            }

            int removeOffset = prevLineStart;
            int removeLen = blockEnd - prevLineStart;

            // Hard clamp because Swing is a goblin
            removeOffset = Math.max(0, Math.min(removeOffset, doc.getLength()));
            removeLen = Math.max(0, Math.min(removeLen, doc.getLength() - removeOffset));

            doc.remove(removeOffset, removeLen);
            doc.insertString(removeOffset, blockText + prevText, null);

            int newSelStart = removeOffset;
            int newSelEnd = removeOffset + blockText.length();
            c.select(newSelStart, newSelEnd);
        }
        else {
            // Need a next line to move down
            if (blockEnd >= docLen) return;

            int nextLineStart = blockEnd;
            int nextLineEndRow = Utilities.getRowEnd(c, nextLineStart);

            if (nextLineEndRow < 0) return;

            int nextLineEnd = nextLineEndRow;
            if (nextLineEnd < docLen) {
                nextLineEnd++;
            }

            String blockText = doc.getText(blockStart, blockEnd - blockStart);
            String nextText = doc.getText(nextLineStart, nextLineEnd - nextLineStart);

            if (applyScopeIndent) {
                String indentUnit = detectIndentUnit(doc);
                String desiredBaseIndent = computeDesiredIndentAt(doc, nextLineStart, indentUnit);
                blockText = reindentBlock(blockText, desiredBaseIndent, indentUnit);
            }

            int removeOffset = blockStart;
            int removeLen = nextLineEnd - blockStart;

            removeOffset = Math.max(0, Math.min(removeOffset, doc.getLength()));
            removeLen = Math.max(0, Math.min(removeLen, doc.getLength() - removeOffset));

            doc.remove(removeOffset, removeLen);
            doc.insertString(removeOffset, nextText + blockText, null);

            int newSelStart = removeOffset + nextText.length();
            int newSelEnd = newSelStart + blockText.length();
            c.select(newSelStart, newSelEnd);
        }
    }
    catch (BadLocationException e) {
        e.printStackTrace();
    }
}
